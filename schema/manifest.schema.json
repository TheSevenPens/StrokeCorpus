{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesevenpens.github.io/StrokeCorpus/schema/manifest.schema.json",
  "title": "The Stroke Corpus catalogue",
  "description": "manifest.json: one entry per recording in traces/, generated by tools/manifest.py. Everything in an entry is measured from the recording or read from it; nothing is typed beside it. A figure is null where the recording does not carry what it needs, which is an absence and not a zero.",
  "type": "object",
  "required": ["format", "formatVersion", "recordings", "totals"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "stroke-corpus/manifest" },
    "formatVersion": { "const": 1 },
    "recordings": { "type": "array", "items": { "$ref": "#/$defs/recording" } },
    "totals": { "$ref": "#/$defs/totals" }
  },
  "additionalProperties": false,

  "$defs": {

    "column": { "enum": ["at", "arrived", "x", "y", "pressure", "height", "status", "lean", "azimuth", "twist"] },
    "count": { "type": "integer", "minimum": 0 },
    "share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "maybeNumber": { "type": ["number", "null"] },
    "maybeInteger": { "type": ["integer", "null"] },

    "recording": {
      "type": "object",
      "required": [
        "file", "id", "name", "recordedAt", "formatVersion", "formatAdded", "gesture", "intent", "endedBy",
        "device", "columns", "coordinateSpace", "channels", "counts", "seconds", "updates", "counters",
        "quality", "qualityMeans", "hoverTrusted", "reRecord", "bytes"
      ],
      "properties": {
        "file": { "type": "string", "pattern": "\\.json$", "description": "The full filename including .json. The lookup key, and the path under traces/." },
        "id": { "type": "string", "description": "The recorder's own identifier, which can differ from the filename." },
        "name": { "type": "string" },
        "recordedAt": { "type": "string" },
        "formatVersion": { "type": "integer", "minimum": 1, "maximum": 8 },
        "formatAdded": { "type": "string" },
        "gesture": { "type": "string" },
        "intent": { "type": "string" },
        "endedBy": { "type": "string" },
        "device": {
          "type": "object",
          "required": ["tablet", "driver", "api", "fullScalePressure", "firmware"],
          "properties": {
            "tablet": { "type": "string" },
            "driver": { "type": "string" },
            "api": { "type": "string" },
            "fullScalePressure": { "$ref": "#/$defs/count" },
            "firmware": { "type": ["string", "null"], "description": "Null before format version 7, where nobody was asked. An empty string means the person was asked and wrote nothing." }
          },
          "additionalProperties": false
        },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "coordinateSpace": { "enum": ["desktop", "tablet"], "description": "What x and y are. A recording before format version 8 does not say, and its positions are desktop positions." },
        "channels": {
          "type": "object",
          "required": ["measured", "absent"],
          "properties": {
            "measured": { "type": "array", "items": { "$ref": "#/$defs/column" } },
            "absent": { "type": "array", "items": { "$ref": "#/$defs/column" } }
          },
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "required": ["strokes", "contact", "approach", "departure", "aloft"],
          "properties": {
            "strokes": { "$ref": "#/$defs/count" },
            "contact": { "$ref": "#/$defs/count" },
            "approach": { "$ref": "#/$defs/count" },
            "departure": { "$ref": "#/$defs/count" },
            "aloft": { "$ref": "#/$defs/count" }
          },
          "additionalProperties": false
        },
        "seconds": {
          "type": "object",
          "description": "How long the recording ran on each clock it carries. Empty where there are too few readings to say.",
          "properties": { "pen": { "type": "number" }, "host": { "type": "number" } },
          "additionalProperties": false
        },
        "updates": { "$ref": "#/$defs/updates" },
        "counters": {
          "description": "Whether the session's own counters agree, where the recording states them; null where it does not.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["fromTheDriver", "delivered", "outsideTheRegion", "agrees"],
              "properties": {
                "fromTheDriver": { "$ref": "#/$defs/count" },
                "delivered": { "$ref": "#/$defs/count" },
                "outsideTheRegion": { "$ref": "#/$defs/count" },
                "agrees": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        },
        "quality": { "enum": ["complete", "partial", "hover-suspect", "single-clock", "early", "raw"] },
        "qualityMeans": { "type": "string" },
        "hoverTrusted": { "type": "boolean" },
        "reRecord": { "type": "array", "items": { "type": "string" } },
        "bytes": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },

    "holds": {
      "description": "How many holds of each length, by length in readings.",
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/count" }
    },

    "updates": {
      "description": "How often each channel carried a new value, measured from the readings. A description of the readings and not a finding about the device: see FORMAT.md, A reading is not a measurement.",
      "type": "object",
      "required": [
        "pairs", "changed", "pressureHolds", "pressureHoldsInterior", "pressurePeriod", "pressurePeriodFit",
        "pressurePeriodSupport", "pressureDistinct", "pressureStep", "readingRateHz", "readingRateSeconds",
        "pressureUpdateHzIfPeriodic"
      ],
      "properties": {
        "pairs": { "$ref": "#/$defs/count" },
        "changed": {
          "type": "object",
          "required": ["position", "pressure", "tilt", "height", "twist"],
          "properties": {
            "position": { "$ref": "#/$defs/share" },
            "pressure": { "$ref": "#/$defs/share" },
            "tilt": { "$ref": "#/$defs/share" },
            "height": { "$ref": "#/$defs/share" },
            "twist": { "$ref": "#/$defs/share" }
          },
          "additionalProperties": false
        },
        "pressureHolds": { "$ref": "#/$defs/holds" },
        "pressureHoldsInterior": { "$ref": "#/$defs/holds" },
        "pressurePeriod": { "type": ["integer", "null"], "minimum": 1 },
        "pressurePeriodFit": { "$ref": "#/$defs/share" },
        "pressurePeriodSupport": { "$ref": "#/$defs/count" },
        "pressureDistinct": { "type": ["integer", "null"], "minimum": 0 },
        "pressureStep": { "$ref": "#/$defs/maybeNumber" },
        "readingRateHz": { "$ref": "#/$defs/maybeNumber" },
        "readingRateSeconds": { "$ref": "#/$defs/maybeNumber" },
        "pressureUpdateHzIfPeriodic": { "$ref": "#/$defs/maybeNumber" }
      },
      "additionalProperties": false
    },

    "totals": {
      "type": "object",
      "required": [
        "recordings", "strokes", "contact", "approach", "aloft", "byQuality", "byPressurePeriod",
        "wantingReRecording", "devices", "backends"
      ],
      "properties": {
        "recordings": { "$ref": "#/$defs/count" },
        "strokes": { "$ref": "#/$defs/count" },
        "contact": { "$ref": "#/$defs/count" },
        "approach": { "$ref": "#/$defs/count" },
        "aloft": { "$ref": "#/$defs/count" },
        "byQuality": {
          "type": "object",
          "propertyNames": { "enum": ["complete", "partial", "hover-suspect", "single-clock", "early", "raw"] },
          "additionalProperties": { "$ref": "#/$defs/count" }
        },
        "byPressurePeriod": {
          "description": "Recordings by the period their pressure holds share, where they had enough interior holds to say.",
          "type": "object",
          "propertyNames": { "pattern": "^[1-9][0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/count" }
        },
        "wantingReRecording": { "$ref": "#/$defs/count" },
        "devices": { "type": "array", "items": { "type": "string" } },
        "backends": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
